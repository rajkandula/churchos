# Copy to .env.local for development (or set these in your host's environment).

# MongoDB connection string (Atlas or self-hosted) — include the database name.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/churchos"

# Public address of the app, used for links in emails (password resets,
# sign-in links), e.g. https://churchos.yourchurch.example. Recommended in
# production; empty falls back to the request host.
APP_URL=""

# Random 32+ byte hex secret for signing session tokens (openssl rand -hex 32).
JWT_SECRET=""

# Media storage: any S3-compatible bucket (member photos, documents, drive files).
# The bucket needs a CORS rule allowing PUT from the app's origin.
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT="https://s3.your-provider.example"
STORAGE_PUBLIC_URL="https://media.yourchurch.example"
# Optional: the bucket's region, if your provider needs one (default "auto").
STORAGE_REGION=""

# Harakumo Mail — every email ChurchOS sends (password resets, approvals,
# invitations, announcements). Turn on Mail for your Harakumo project and create
# a key under Settings → API keys. Server-side only. Without it, email features
# report "not set up" and everything else works.
HARAKUMO_API_KEY=""
# Optional: sender address on a domain you verified in Harakumo Mail, and the
# display name (default "ChurchOS").
MAIL_FROM=""
MAIL_FROM_NAME=""
# Optional: Harakumo API origin (default https://harakumo.com).
HARAKUMO_BASE_URL=""

# Company inbox: contact-form notifications go here, and company-console mail
# asks for replies here. Empty = notify the first company admin instead.
CONTACT_EMAIL=""

# Scheduled announcements: the server checks every five minutes by itself.
# Set ANNOUNCEMENT_SCHEDULER=off to rely on an external scheduler instead, which
# calls POST /api/cron/dispatch-announcements with the header
# x-cron-secret: <CRON_SECRET> (openssl rand -hex 32). Unset = that route is 404.
ANNOUNCEMENT_SCHEDULER=""
CRON_SECRET=""

# Optional inbound mail for the company console's Mailbox: forward mail to
# POST /api/mail/inbound with the header x-inbound-secret: <INBOUND_MAIL_SECRET>
# (raw RFC 822 body, or JSON). Unset = that route is 404.
INBOUND_MAIL_SECRET=""
